{
  "name": "workgremlin",
  "version": "0.1.10",
  "private": true,
  "main": "desktop/src/launcher.js",
  "description": "WorkGremlin - 可视化桌面程序：管理与监控多 agent 协作团队",
  "license": "MIT",
  "workspaces": [
    "shared",
    "server",
    "desktop",
    "renderer",
    "packages/reporter"
  ],
  "dependencies": {
    "@workgremlin/shared": "*",
    "@workgremlin/server": "*",
    "@workgremlin/reporter": "*"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "rebuild:native": "node scripts/postinstall.js --force",
    "dev": "node scripts/dev.js",
    "server": "node server/src/cli.js",
    "build": "npm run build --workspace @workgremlin/renderer",
    "start": "electron desktop/src/main.js",
    "build:electron": "npm run build && npm run launch:electron",
    "launch:electron": "electron desktop/src/launcher.js",
    "db:check": "node server/src/cli.js --self-test",
    "hooks:install": "node scripts/install-hooks.js",
    "hooks:uninstall": "node scripts/install-hooks.js --uninstall",
    "test:elevator": "node renderer/test/elevator.t3.test.mjs",
    "test:done": "node server/test/doneAttribution.test.js",
    "test:floors": "node server/test/mergedFloors.test.js",
    "test:session-project": "node server/test/sessionProject.test.js",
    "test:kilo": "node server/test/kiloFloor.test.js",
    "test:plugin-ingest": "node server/test/pluginIngest.test.js",
    "test:plugin-e2e": "node server/test/kiloPluginE2E.test.js",
    "test:ghost-feed": "node server/test/ghostFeed.test.js",
    "test:opencode": "node server/test/opencodeFloor.test.js",
    "test:tokens": "node server/test/taskTokens.test.js",
    "test:done-shape": "node server/test/doneShape.test.js",
    "test:task-filter": "node server/test/taskFilter.test.js",
    "test:retention": "node server/test/retention.test.js",
    "test:claude-model": "node server/test/claudeModel.test.js",
    "test:trae-model": "node server/test/traeModel.test.js",
    "test:ghost": "node server/test/ghostRace.test.js",
    "test:ghost-ledger": "node server/test/ghostLedger.test.js",
    "test:recover": "node server/test/taskRecover.test.js",
    "test:qoder": "node server/test/qoderHook.test.js",
    "test:qoder-plugin": "node server/test/qoderPlugin.test.js",
    "test:ide-hook": "node server/test/ideHook.test.js",
    "test:task-client": "node renderer/test/taskClientLabel.test.mjs",
    "test:member-task": "node renderer/test/memberTask.test.mjs",
    "test:project-scope": "node renderer/test/projectScope.test.mjs",
    "test:day-board": "node renderer/test/dayBoard.test.mjs",
    "test:i18n": "node renderer/test/i18n.test.mjs",
    "test:canvas-scene": "node renderer/test/canvasScene.test.mjs",
    "test:render-smoke": "node renderer/test/renderSmoke.test.mjs",
    "test:time-range": "node renderer/test/timeRange.test.mjs",
    "test:agent-desc": "node server/test/agentDescription.test.js",
    "test:ws-reconnect": "node renderer/test/wsReconnect.test.mjs",
    "test:claude-hook": "node server/test/claudeHook.test.js",
    "test:claude-cancel": "node server/test/claudeCancel.test.js",
    "test:cancel-flush": "node server/test/cancelFlush.test.js",
    "test:project-attribution": "node server/test/projectAttribution.test.js",
    "test:truncated-ws": "node server/test/truncatedWorkspace.test.js",
    "test:cancel": "node server/test/interruptCancel.test.js",
    "test:codebuddy-cancel": "node server/test/codebuddyCancel.test.js",
    "test:final-stop": "node server/test/finalStop.test.js",
    "test:stop-interrupt": "node server/test/stopInterrupt.test.js",
    "test:task-runs-route": "node server/test/taskRunsRoute.test.js",
    "test:task-sync": "node server/test/taskSync.test.js",
    "test:council-consensus": "node server/test/councilConsensus.test.js",
    "test:council-store": "node server/test/councilStore.test.js",
    "test:council-agents": "node server/test/councilAgents.test.js",
    "test:council-runner": "node server/test/councilRunner.test.js",
    "test:council-orchestrator": "node server/test/councilOrchestrator.test.js",
    "test:council-materials": "node server/test/councilMaterials.test.js",
    "test:council-api": "node server/test/councilApi.test.js",
    "test:council-quiet-plugin": "node server/test/councilPluginQuiet.test.js",
    "test:council-timeline": "node renderer/test/councilTimeline.test.mjs",
    "test:council-ui-store": "node renderer/test/councilUiStore.test.mjs",
    "test:all": "node scripts/run-tests.js",
    "test:token-backfill": "node server/test/tokenBackfill.test.js"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "electron": "38.8.6",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "esbuild@0.25.12": true,
    "vue-demi@0.14.10": true,
    "better-sqlite3@13.0.3": true
  }
}
